# Copy this file to .env and fill in real values

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Google Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# SQLite for local development.
# For production, use a persistent PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./repo_analyzer.db

# Where repos get cloned temporarily during analysis
CLONE_DIR=./tmp_repos

# Production frontend URL for CORS.
# Keep this as http://localhost:5173 locally.
FRONTEND_URL=http://localhost:5173
