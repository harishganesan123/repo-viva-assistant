# Copy this file to .env and fill in real values

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
# SQLite by default — swap for a Postgres URL later, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/repo_analyzer
DATABASE_URL=sqlite:///./repo_analyzer.db

# Where repos get cloned temporarily during analysis
CLONE_DIR=./tmp_repos
